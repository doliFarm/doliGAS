# =============================================================================
# doliGAS - variabili d'ambiente (copiare in .env e adattare)
# Il file .env NON va versionato.
# =============================================================================

# --- Ambiente ---------------------------------------------------------------
# dev  = sviluppo (container con nodemon e Vite)
# prod = produzione (container con node e nginx)
APP_ENV=prod

# --- Database ---------------------------------------------------------------
DB_ROOT_PASSWORD=cambiami_root
DB_NAME=gashub_prod
DB_USER=gashub
DB_PASSWORD=cambiami
# DB_HOST e DB_PORT sono impostati dal docker-compose; servono solo fuori da Docker
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Applica le migrazioni dello schema all'avvio del backend (consigliato: non impostare).
# Mettere a false solo se si vogliono applicare a mano con `npm run migrate`.
# DB_AUTO_MIGRATE=false

# --- Sicurezza --------------------------------------------------------------
# OBBLIGATORIO, almeno 32 caratteri. Generare con:  openssl rand -hex 32
# Cambiandolo, tutte le sessioni attive decadono e gli utenti rifanno l'accesso.
JWT_SECRET=

# --- Rete -------------------------------------------------------------------
API_PORT=3000
PROXY_NETWORK_NAME=proxy_net
# Vuoto in produzione dietro nginx (percorsi relativi)
VITE_API_URL=
VITE_SESSION_DURATION_MINUTES=120
# Mostra l'avviso "questa è un'istanza dimostrativa" dopo l'accesso.
# Solo per la demo pubblica: su un'installazione reale di un GAS lasciare false.
VITE_DEMO_MODE=false

# --- Email (SMTP) -----------------------------------------------------------
# Senza SMTP_HOST le email non vengono inviate: restano simulate nei log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=doliGAS
SMTP_FROM_EMAIL=info@doligas.com
# Destinatario delle notifiche di servizio (richieste dal form contatti)
ADMIN_EMAIL=

# --- Automazione del ciclo G1-G7 --------------------------------------------
# Lo scheduler invia le notifiche delle tappe del ciclo. Attivo per impostazione
# predefinita; mettere a false per spegnerlo (es. su un secondo backend di prova
# che punta allo stesso database).
# SCHEDULER_ENABLED=false
# Pianificazione in formato cron; se omessa, ogni ora al minuto 0.
# SCHEDULER_CRON=0 * * * *

# --- Debug e demo -----------------------------------------------------------
# ATTENZIONE: abilita /api/debug (log del server, solo per utenti autenticati).
# Non viene montato quando APP_ENV=prod. Mai su istanze pubbliche.
# ENABLE_DEBUG_API=true

# Restituisce il codice di accesso nella risposta di login, così il frontend lo
# mostra nella console di debug. Serve SOLO alle istanze dimostrative senza SMTP,
# dove non c'è altro modo di riceverlo.
# ATTENZIONE: con questa opzione attiva, chi conosce un indirizzo email può
# accedere come quella persona. Mai su un'installazione reale di un GAS:
# configurare invece SMTP_HOST qui sopra.
# DEMO_SHOW_OTP=true
