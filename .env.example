# =============================================================================
# doliGAS - environment variables (copy to .env and adapt)
# The .env file must NOT be committed.
# =============================================================================

# --- Environment ------------------------------------------------------------
# dev  = development (containers with nodemon and Vite)
# prod = production (containers with node and nginx)
APP_ENV=prod

# --- Database ---------------------------------------------------------------
DB_ROOT_PASSWORD=cambiami_root
DB_NAME=gashub_prod
DB_USER=gashub
DB_PASSWORD=cambiami
# DB_HOST and DB_PORT are set by docker-compose; needed only outside Docker
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Applies the schema migrations when the backend starts (recommended: leave unset).
# Set to false only to apply them by hand with `npm run migrate`.
# DB_AUTO_MIGRATE=false

# --- Security ---------------------------------------------------------------
# REQUIRED, at least 32 characters. Generate with:  openssl rand -hex 32
# Changing it invalidates all active sessions and users must log in again.
JWT_SECRET=

# --- Network ----------------------------------------------------------------
API_PORT=3000
PROXY_NETWORK_NAME=proxy_net
# Time zone of the GAS, used by both the database and the API (default Europe/Rome).
# Cycle dates are entered and stored as local time of this zone.
# APP_TZ=Europe/Rome
# Empty in production behind nginx (relative paths)
VITE_API_URL=
VITE_SESSION_DURATION_MINUTES=120
# Shows the "this is a demo instance" notice after login.
# Public demo only: leave false on a real GAS installation.
VITE_DEMO_MODE=false

# --- Email (SMTP) -----------------------------------------------------------
# Without SMTP_HOST emails are not sent: they are only simulated in the logs
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=doliGAS
SMTP_FROM_EMAIL=info@doligas.com
# Recipient of service notifications (contact form requests)
ADMIN_EMAIL=

# --- G1-G7 cycle automation -------------------------------------------------
# The scheduler sends the notifications for the cycle steps. On by default;
# set to false to turn it off (e.g. on a second test backend pointing to the
# same database).
# SCHEDULER_ENABLED=false
# Schedule in cron format; if omitted, every hour at minute 0.
# SCHEDULER_CRON=0 * * * *

# --- Debug and demo ---------------------------------------------------------
# WARNING: enables /api/debug (server logs, authenticated users only).
# Not mounted when APP_ENV=prod. Never on public instances.
# ENABLE_DEBUG_API=true

# Returns the access code in the login response, so the frontend shows it in
# the debug console. Needed ONLY by demo instances without SMTP, where there is
# no other way to receive it.
# WARNING: with this option on, anyone who knows an email address can log in
# as that person. Never on a real GAS installation: configure SMTP_HOST above
# instead.
# DEMO_SHOW_OTP=true
